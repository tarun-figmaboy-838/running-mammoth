# Generated intermediates. tools/gif-to-grid.mjs rebuilds these from the GIFs in
# game/assets/GIF/, which ARE committed — so they are ~10MB of PNG that a checkout
# does not need. Regenerate with:
#   node tools/gif-to-grid.mjs sprite-max-px-frames-36-rows-6-cols-6.gif   run-gif.png
#   node tools/gif-to-grid.mjs sprite-max-px-frames-36-rows-6-cols-6-2.gif jump-gif.png
#   node tools/gif-to-grid.mjs sprite-max-px-frames-36-rows-6-cols-6-3.gif skid-gif.png
#   node tools/slice-char.mjs
game/assets/char/*-gif.png
